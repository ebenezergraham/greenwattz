rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Quote details from the quote checker: specification, price breakdown, installer name and website.
    // Anyone can add one document; nobody can read, change or delete from the web.
    match /quotes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['reader', 'installer', 'website', 'dataJson'])
        && request.resource.data.keys().hasAll(['reader', 'dataJson'])
        && request.resource.data.reader in ['rules', 'ai']
        && request.resource.data.dataJson is string
        && request.resource.data.dataJson.size() <= 6000
        && (!('installer' in request.resource.data) || (request.resource.data.installer is string && request.resource.data.installer.size() <= 120))
        && (!('website' in request.resource.data) || (request.resource.data.website is string && request.resource.data.website.size() <= 120));
      allow read, update, delete: if false;
    }
    // A signed-in visitor's saved plans and quote comparisons. Only that visitor can read, change or delete them.
    // A save holds answers and figures as JSON, never a quote file or meter readings.
    match /users/{uid}/saves/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['kind', 'name', 'dataJson', 'updatedAt'])
        && request.resource.data.keys().hasAll(['kind', 'name', 'dataJson', 'updatedAt'])
        && request.resource.data.kind in ['plan', 'quotes']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.dataJson is string && request.resource.data.dataJson.size() <= 60000
        && request.resource.data.updatedAt == request.time;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
